<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">
    <!-- HandyControls 3.7.0 using the style bases selected by MaaWpfGui.
         Reference: Res/Theme.xaml, Res/Styles/{Button,ComboBox}.xaml,
         Res/Themes/Dark.xaml and Views/UI/RootView.xaml in the local MAA source. -->
    <ResourceDictionary.MergedDictionaries>
        <hc:ThemeResources />
        <hc:Theme />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="RegionBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="RegionBrushOpacity25" Color="#401C1C1C" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#7FE6E6E6" />
    <SolidColorBrush x:Key="TextIconBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MouseOverRegionBrush" Color="#2B2B30" />
    <SolidColorBrush x:Key="InfoLogBrush" Color="#00C8C8" />
    <SolidColorBrush x:Key="ErrorLogBrush" Color="Red" />

    <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource RegionBrushOpacity25}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxExtend}">
        <Setter Property="Background" Value="{DynamicResource RegionBrushOpacity25}" />
    </Style>
    <Style x:Key="FieldToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource RegionBrushOpacity25}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RegionBrushOpacity25}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Padding" Value="8" />
    </Style>
</ResourceDictionary>

